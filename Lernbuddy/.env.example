# OpenAI-compatible provider, for example TokenHarbor:
AI_BASE_URL=https://tokenharbor.ai/v1
AI_MODEL=deepseek-v4.1-flash:free

# Zwei Möglichkeiten für den API-Key – entweder im Klartext:
AI_API_KEY=your_api_key_here

# ... oder verschlüsselt (hat Vorrang, wenn gesetzt). Dafür APP_ENCRYPTION_KEY
# setzen und den Wert mit `python security.py --encrypt "<key>"` erzeugen:
# AI_API_KEY_ENCRYPTED=

# Schlüssel für die Verschlüsselung. Erzeugen mit:
#   cd backend && python security.py --generate-key
# Niemals ins Repository legen. Geht er verloren, sind verschlüsselte Werte weg.
APP_ENCRYPTION_KEY=
